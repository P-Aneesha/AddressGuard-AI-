# Secrets are set as Vercel environment variables, never uploaded.
.env
.env.*
!.env.example

# Local tooling and caches
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
instance/
*.db
tests/

# Raw reference data and the uncompressed index (258 MB).
# The app runs from data/reference_index.sqlite3.gz on Vercel.
data/*.csv
data/*.sqlite3
data/*.partial

# Large evaluation artefacts not needed at runtime
# (the dashboard reads only evaluation/results/evaluation_results.json)
evaluation/datasets/
evaluation/reports/
evaluation/results/*
!evaluation/results/evaluation_results.json
docs/
